{
  "name": "askwell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "echo 'db:types is not set up yet: it arrives in Phase 1 (Supabase CLI + SUPABASE_PROJECT_ID). It will run: supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > packages/db/types.ts' >&2 && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0"
  }
}
