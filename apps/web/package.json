{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "widget": "pnpm --filter widget build && node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../widget/dist/widget.js','public/widget.js')\"",
    "dev": "pnpm run widget && next dev",
    "build": "pnpm run widget && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@arcjet/next": "^1.16.0",
    "@askwell/db": "workspace:*",
    "@askwell/shared": "workspace:*",
    "@clerk/nextjs": "^7.10.8",
    "@google/genai": "^3.6.1",
    "@posthog/ai": "^8.22.4",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "posthog-js": "^1.455.4",
    "posthog-node": "^6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1",
    "widget": "workspace:*"
  }
}
