# Copy to .env.local and fill in. Never commit real values.
# Vercel: Preview + Development use the Supabase dev project, Production uses prod.

# --- Public (NEXT_PUBLIC_*, shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
# Public by design: RLS is the boundary
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_APP_URL=

# --- Server only (never in NEXT_PUBLIC_* or the widget bundle) ---
# Acts as service_role and skips RLS
SUPABASE_SECRET_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
OPENAI_API_KEY=
ARCJET_KEY=
# A public widget key, but per-environment config read at request time
LANDING_WIDGET_KEY=
